        }
      }
    },
    "XtraPic saknar behörighet att använda kameran. Godkänn i Systeminställningar > Sekretess och säkerhet > Kamera." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XtraPic doesn't have permission to use the camera. Approve it in System Settings > Privacy & Security > Camera."
